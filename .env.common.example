# llmux 공통 설정 템플릿
# install -m 600 .env.common.example .env.common 후 값 수정

# ─── HuggingFace ───────────────────────────────────────────────
# 게이트 모델 다운로드에 사용 (공개 repo 만 쓰면 비워도 됨)
HF_TOKEN=
HF_CACHE_PATH=$HOME/.cache/huggingface

# GGUF 다운로드(prepare)를 실행할 이미지. llama.cpp 이미지에는 python/huggingface_hub
# 가 없어 별도 지정이 필요하다 — vLLM 이미지면 그대로 쓸 수 있다.
PREPARE_DOWNLOADER_IMAGE=vllm/vllm-openai:v0.27.1

# 다운로드 병렬 연결 수. HF 는 연결당 속도를 묶어두므로 사실상 대역폭 조절이다
# (실측 1연결 5MB/s, 8연결 56MB/s). 업무시간에 회선을 다 먹지 않으려면 낮춘다.
# 비우면 huggingface_hub 기본값. `prepare --max-workers` 로 건별 override.
PREPARE_MAX_WORKERS=

# ─── vLLM 전용 ─────────────────────────────────────────────────
# LoRA adapter 경로 (container 안 /app/lora 로 mount)
LORA_BASE_PATH=

# thinking_token_budget(추론 길이 제한)을 쓰려면 0 으로. V2 runner(기본값 1)는
# 이 파라미터를 지원하지 않아 요청이 400 으로 떨어진다.
# 주의: config 에 speculative-config(MTP)가 켜져 있으면 0 이어도 budget 이 무시된다.
VLLM_USE_V2_MODEL_RUNNER=1

# Docker Compose 직접 실행용 이미지; llmux 기동·자동완성은 profile.image_tag 기준.
VLLM_IMAGE=

# vLLM dev-build (per-fork / PR branch). 비워두면 vllm-project/main 사용.
#   uv run llmux image build-dev --backend vllm
VLLM_REPO_URL=https://github.com/vllm-project/vllm.git
VLLM_BRANCH=main

# ─── llama.cpp 전용 ────────────────────────────────────────────
# 로컬 GGUF 저장 경로. 더 이상 컨테이너에 mount 되지 않는다 (모델은
# llama-server 가 -hf 로 HF 캐시에 직접 받는다) — 레거시 감지·disk 뷰 용도로만 쓰인다.
MODEL_DIR=$HOME/.llmux/models

# llama.cpp 이미지 태그
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# llama.cpp dev-build (per-fork / PR branch). 비워두면 ggml-org/master 사용.
# 사용:
#   uv run llmux image build-dev --backend llamacpp
#   → LLAMACPP_REPO_URL 의 LLAMACPP_BRANCH 를 .llamacpp-src/ 에 clone 후
#     llamacpp-dev:<branch> 이미지 빌드.
#   프로필에서는 profiles.yaml 에 `image_tag: llamacpp-dev:<branch>` 로 지정.
LLAMACPP_REPO_URL=https://github.com/ggml-org/llama.cpp.git
LLAMACPP_BRANCH=master

# 타임존
TZ=UTC
